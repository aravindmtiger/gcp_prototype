# =============================================================================
#  GCP Agentflow - single configuration file
# =============================================================================
#  Copy to .env and edit. The SAME file drives:
#    * local development  (backend: uvicorn, frontend: vite, infra: docker compose)
#    * production         (deploy/scripts/deploy.sh reads it and pushes values to
#                          Cloud Run; secrets are pulled from Secret Manager)
#
#  Rules:
#    - No quotes needed. Keep values on one line. Empty value = unset.
#    - Lines starting with "#" are comments.
#    - Keys prefixed UI_ are exposed to the browser; everything else stays server-side.
#    - Keys listed in deploy/scripts/env_to_cloudrun.py SECRET_KEYS are never written
#      as plain text to Cloud Run; they are mounted from Secret Manager instead.
# =============================================================================

# ---------------------------------------------------------------- Runtime ----
# local | staging | production   (production enforces Google auth, a real LLM, explicit CORS)
APP_ENV=local
APP_NAME=gcp-agentflow
LOG_LEVEL=INFO
# text (human readable) | json (Cloud Logging structured logs)
LOG_FORMAT=text
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------- Authentication --
# dev    -> trusts the X-Dev-User header. Local only; refused when APP_ENV=production.
# google -> verifies Google ID tokens (Google Identity Services sign-in).
AUTH_MODE=dev
DEV_USER_EMAIL=dev@example.com
# OAuth 2.0 Web client ID from Google Cloud Console > APIs & Services > Credentials.
# Add http://localhost:5173 (and the UI Cloud Run URL) as authorized JavaScript origins.
GOOGLE_CLIENT_ID=
# Comma-separated email domains allowed to sign in, e.g. example.com,example.org. Empty = any.
ALLOWED_EMAIL_DOMAINS=
# Comma-separated admin emails. They are always admins, even if the Users section says otherwise.
ADMIN_EMAILS=
# Role for new users: platform_user or platform_admin. The default account is seeded as admin.
DEFAULT_USER_ROLE=platform_user

# ---------------------------------------------- Database (Cloud SQL + pgvector)
# Local (docker compose):
DATABASE_URL=postgresql+asyncpg://agentflow:agentflow@localhost:5432/agentflow
# Cloud SQL over the Cloud Run unix socket (the deploy script sets this from Secret Manager):
#   postgresql+asyncpg://agentflow:<URL-ENCODED-PASSWORD>@/agentflow?host=/cloudsql/PROJECT:REGION:INSTANCE
# Create tables and the vector extension on startup. Set false once Alembic manages the schema.
DB_AUTO_CREATE=true
DB_POOL_SIZE=5

# ------------------------------------------------- Cache (Memorystore Redis) --
# Used for per-user run rate limiting. Empty disables it.
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_RUNS_PER_MINUTE=30

# ------------------------------------------- Models (Vertex AI Agent Platform) --
# mock   -> offline, deterministic stub (no cloud calls)
# gemini -> Gemini via google-genai
# claude -> Claude on Vertex AI (needs GCP_PROJECT_ID)
LLM_PROVIDER=mock
# api_key -> Gemini Developer API with GEMINI_API_KEY (local experiments)
# vertex  -> Gemini on Vertex AI using the Cloud Run service account (use in production)
GENAI_BACKEND=api_key
GEMINI_API_KEY=
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Check the exact Claude model ID enabled in Vertex AI Model Garden for your project.
CLAUDE_MODEL=claude-sonnet-5-5
EMBEDDING_MODEL=text-embedding-005
# Must match the vector size of the document_chunks table (text-embedding-005 = 768).
EMBEDDING_DIM=768
LLM_MAX_OUTPUT_TOKENS=1024

# ------------------------------------------------ Object storage (Cloud Storage)
# local -> LOCAL_STORAGE_DIR on disk.   gcs -> GCS_BUCKET.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage
GCS_BUCKET=
# Deploying agents to Google Cloud (DEPLOY_BACKEND=gcp). Leave local until a project is set.
# Cloud Run builds images into this Artifact Registry repo, in GCP_LOCATION.
DEPLOY_BACKEND=local
GCP_ARTIFACT_REPO=agentflow
# The one service account every deployed agent runs as. Grant it only what agents need.
AGENT_RUNTIME_SERVICE_ACCOUNT=

# ----------------------------------------------------- Run dispatch ----------
# inline      -> run in a background task inside the API process (local).
# cloud_tasks -> enqueue on Cloud Tasks; Cloud Tasks calls the API with OIDC. Production.
TASK_BACKEND=inline
CLOUD_TASKS_QUEUE=agentflow-runs
CLOUD_TASKS_LOCATION=us-central1
# Service account Cloud Tasks uses to call /internal/... (created by bootstrap_gcp.sh).
CLOUD_TASKS_INVOKER_SA=
# Public URL of the API. Cloud Tasks audience. Filled in by deploy.sh in production.
BACKEND_PUBLIC_URL=http://localhost:8080

# ----------------------------------------------------------- Guardrails ------
# Redact emails, phone numbers, card numbers and SSNs before text reaches a model.
PII_REDACTION_ENABLED=true

# ------------------------------------------------------------ Observability ---
# Spans for every node run and HTTP request.
OTEL_ENABLED=false
# console -> print spans locally.   gcp -> Cloud Trace (uses the service account).
OTEL_EXPORTER=console

# --------------------------------------------------- Frontend (UI_* only) -----
# Backend URL the browser calls. Production: the API Cloud Run URL (set by deploy.sh).
UI_API_BASE_URL=http://localhost:8080
# dev | google   (must match AUTH_MODE on the backend)
UI_AUTH_MODE=dev
# Same value as GOOGLE_CLIENT_ID.
UI_GOOGLE_CLIENT_ID=
UI_DEV_USER=dev@example.com

# ------------------------------------------------- Deployment (deploy/ only) ---
# Read by deploy/scripts/*.sh (GCP_PROJECT_ID above is reused). Stripped before
# values are sent to Cloud Run, so the application never sees these.
GCP_REGION=us-central1
ARTIFACT_REGISTRY_REPO=agentflow
BACKEND_SERVICE_NAME=agentflow-api
FRONTEND_SERVICE_NAME=agentflow-ui
BACKEND_SERVICE_ACCOUNT=agentflow-api-sa
FRONTEND_SERVICE_ACCOUNT=agentflow-ui-sa
# Cloud SQL instance created by bootstrap_gcp.sh, format PROJECT:REGION:INSTANCE.
CLOUD_SQL_CONNECTION_NAME=
CLOUD_SQL_TIER=db-custom-1-3840
CLOUD_SQL_DB=agentflow
CLOUD_SQL_USER=agentflow
# Optional Serverless VPC connector name, required only to reach Memorystore (REDIS_URL).
VPC_CONNECTOR=
# Scaling and sizing of the Cloud Run services.
BACKEND_MIN_INSTANCES=0
BACKEND_MAX_INSTANCES=10
BACKEND_CPU=1
BACKEND_MEMORY=1Gi
FRONTEND_MIN_INSTANCES=0
FRONTEND_MAX_INSTANCES=5
